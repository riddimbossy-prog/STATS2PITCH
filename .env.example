# Stats2Pitch 2.2 — GitHub + Supabase only
APP_TIMEZONE=UTC
ALLOW_PUBLIC_SIGNUP=true
AUTO_REFRESH_TTL_MINUTES=45
# 0 = unlimited eligible fixtures per refresh. Set a positive number only if you intentionally want a cap.
MAX_FIXTURES_PER_REFRESH=0
REFRESH_CONCURRENCY=4
BOARD_DAYS_FORWARD=0

# GitHub Actions secrets used by Pages + refresh worker
# SUPABASE_URL may be the full URL, the *.supabase.co host, or just the project ref.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Provider secrets used by the GitHub refresh worker and synced to Supabase Edge Functions
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_FOOTBALL_ODDS_MAX_PAGES=8
API_FOOTBALL_TIMEOUT_MS=12000
API_FOOTBALL_RETRIES=1

# Optional odds fallback for the scheduled engine worker
STATS_API_KEY=
STATS_API_BASE_URL=https://api.thestatsapi.com/api
STATS_API_REQUESTS_PER_MINUTE=40
STATS_API_MIN_INTERVAL_MS=300
STATS_API_TIMEOUT_MS=15000
STATS_API_RETRIES=1
ODDS_PREFERRED_BOOKMAKER=

# Optional machine export token
STATS2PITCH_ELITE_FEED_TOKEN=
STATS2PITCH_ALLOWED_ORIGIN=https://www.stats2pitch.com
