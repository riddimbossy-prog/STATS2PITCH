PORT=3000
APP_TIMEZONE=UTC
CACHE_TTL_SECONDS=900
MAX_FIXTURES_PER_REFRESH=60
ALLOW_MANUAL_REFRESH=true
ALLOW_PUBLIC_SIGNUP=true

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private machine-to-machine token used by sporty.codes to import the daily Elite feed.
# Use a long random secret in Render/GitHub; never expose it in browser JavaScript.
STATS2PITCH_ELITE_FEED_TOKEN=

API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_FOOTBALL_ODDS_MAX_PAGES=10

# Optional but recommended: adds broader football odds/market coverage.
STATS_API_KEY=
STATS_API_BASE_URL=https://api.thestatsapi.com/api
STATS_API_MIN_INTERVAL_MS=300
STATS_API_REQUESTS_PER_MINUTE=40
STATS_VALUE_CACHE_TTL_SECONDS=1800
STATS_API_COMPETITION_PAGES=5
STATS_API_MAX_MATCH_PAGES=5
STATS_API_FALLBACK_MATCH_PAGES=5

# Optional. If this exact bookmaker is present, its prices are used first.
# Otherwise Stats2Pitch prefers Pinnacle, Betfair Exchange, Bet365, then Kambi.
ODDS_PREFERRED_BOOKMAKER=
