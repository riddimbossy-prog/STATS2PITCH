# STATS2PITCH v4
APP_TIMEZONE=UTC
PORT=3000

# Prediction qualification
ENGINE_MIN_ODD=1.20
ENGINE_MAX_ODD=1.55
ENGINE_MIN_CONSENSUS=80
ENGINE_FORM_SAMPLE=5

# Odds comparison
ODDS_VERIFY_MAX_RELATIVE_DIFF=0.15
ODDS_REQUIRE_CROSS_SOURCE=false

# Football data
API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io
API_FOOTBALL_HISTORY_LAST=40
API_FOOTBALL_ODDS_MAX_PAGES=8
API_FOOTBALL_TIMEOUT_MS=15000

# Secondary stats data
STATS_API_KEY=
STATS_API_BASE_URL=https://api.thestatsapi.com/api
STATS_API_TIMEOUT_MS=15000
STATS_API_MATCH_TOLERANCE_HOURS=6

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Board + result maintenance
BOARD_DAYS_FORWARD=6
REFRESH_CONCURRENCY=3
RESULT_LOOKBACK_DAYS=45

# Optional private admin controls
# Comma-separated Supabase account emails that may use /admin.html
STATS2PITCH_ADMIN_EMAILS=
# Optional GitHub fine-grained token with Actions write permission for the repo.
# Needed only for the "Run board refresh" button in the private admin page.
STATS2PITCH_GITHUB_TOKEN=
STATS2PITCH_GITHUB_REPO=riddimbossy-prog/STATS2PITCH
